# --- Server ---
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# --- Supabase (Postgres + Auth + Realtime) ---
# Local dev: values printed by `supabase start`
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (used by supabase config.toml env substitution)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Cloudflare R2 (file storage; any S3-compatible endpoint) ---
# Local dev: point at the Supabase storage S3 endpoint printed by
# `supabase start` (R2_ENDPOINT + S3 access keys, R2_REGION=local).
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=baranwal-associates
R2_PUBLIC_BASE_URL=

# --- OpenAI (AI interior chat) ---
OPENAI_API_KEY=

# --- Razorpay (payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Resend (transactional email) ---
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=

# --- WhatsApp deep link (public) ---
WHATSAPP_PHONE=
